rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function currentUserExists() {
      return signedIn() && exists(userPath());
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function userRole() {
      return currentUserExists() ? currentUser().role : null;
    }

    function userCompanyId() {
      return currentUserExists() ? currentUser().companyId : null;
    }

    function hasCompanyId(value) {
      return value != null && value is string && value.size() > 0;
    }

    function isPlatformAdmin() {
      return signedIn() && userRole() in ['super_admin', 'Super Admin', 'SUPER_ADMIN'];
    }

    function isOwner() {
      return signedIn() && userRole() in ['owner', 'Owner', 'OWNER'];
    }

    function isAdmin() {
      return signedIn() && userRole() in ['admin', 'Admin', 'ADMIN'];
    }

    function isManager() {
      return signedIn() && userRole() in [
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'field_manager', 'Field Manager', 'FIELD_MANAGER',
        'sales_manager', 'Sales Manager', 'SALES_MANAGER',
        'dispatcher', 'Dispatcher', 'DISPATCHER',
        'hr', 'HR',
        'hr_manager', 'HR Manager', 'HR_MANAGER',
        'customer_support_manager', 'Customer Support Manager', 'CUSTOMER_SUPPORT_MANAGER'
      ];
    }

    function isSales() {
      return signedIn() && userRole() in [
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function isTechnician() {
      return signedIn() && userRole() in [
        'technician', 'Technician', 'TECHNICIAN',
        'tech', 'Tech', 'TECH',
        'lead_technician', 'Lead Technician', 'LEAD_TECHNICIAN'
      ];
    }

    function isCleaner() {
      return signedIn() && userRole() in [
        'cleaner', 'Cleaner', 'CLEANER',
        'lead_cleaner', 'Lead Cleaner', 'LEAD_CLEANER'
      ];
    }

    function isFieldStaff() {
      return signedIn() && (
        isTechnician() ||
        isCleaner() ||
        userRole() in [
          'staff', 'Staff', 'STAFF',
          'field_staff', 'Field Staff', 'FIELD_STAFF',
          'crew_lead', 'Crew Lead', 'CREW_LEAD',
          'quality_control', 'Quality Control', 'QUALITY_CONTROL',
          'customer_support', 'Customer Support', 'CUSTOMER_SUPPORT'
        ]
      );
    }

    function isCustomer() {
      return signedIn() && userRole() in ['customer', 'Customer', 'CUSTOMER'];
    }

    function isVendor() {
      return signedIn() && userRole() in [
        'vendor', 'Vendor', 'VENDOR',
        'lead_vendor', 'Lead Vendor', 'LEAD_VENDOR',
        'service_vendor', 'Service Vendor', 'SERVICE_VENDOR',
        'management_program', 'Management Program', 'MANAGEMENT_PROGRAM'
      ];
    }

    function isTenantExecutive() {
      return isOwner() || isAdmin();
    }

    function isTenantLeadership() {
      return isTenantExecutive() || isManager();
    }

    function isTenantWorkforce() {
      return isTenantLeadership() || isSales() || isFieldStaff() || isVendor();
    }

    function sameCompanyId(companyId) {
      return signedIn()
        && hasCompanyId(userCompanyId())
        && hasCompanyId(companyId)
        && userCompanyId() == companyId;
    }

    function hasDataCompany(data) {
      return data.keys().hasAny(['companyId']) && hasCompanyId(data.companyId);
    }

    function sameCompanyData(data) {
      return hasDataCompany(data) && sameCompanyId(data.companyId);
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function assignedToMe(data) {
      return signedIn() && (
        (data.keys().hasAny(['assignedTo']) && data.assignedTo is list && request.auth.uid in data.assignedTo) ||
        (data.keys().hasAny(['assignedTeamIds']) && data.assignedTeamIds is list && request.auth.uid in data.assignedTeamIds) ||
        (data.keys().hasAny(['assignedToUid']) && data.assignedToUid == request.auth.uid) ||
        (data.keys().hasAny(['assignedRep']) && data.assignedRep == request.auth.uid) ||
        (data.keys().hasAny(['technicianUid']) && data.technicianUid == request.auth.uid) ||
        (data.keys().hasAny(['cleanerUid']) && data.cleanerUid == request.auth.uid) ||
        (data.keys().hasAny(['staffClaimedBy']) && data.staffClaimedBy == request.auth.uid)
      );
    }

    function customerOwns(data) {
      return signedIn() && (
        (data.keys().hasAny(['customerUid']) && data.customerUid == request.auth.uid) ||
        (data.keys().hasAny(['customerId']) && data.customerId == request.auth.uid) ||
        (data.keys().hasAny(['userId']) && data.userId == request.auth.uid) ||
        (data.keys().hasAny(['createdByUid']) && data.createdByUid == request.auth.uid && isCustomer())
      );
    }

    function vendorOwns(data) {
      return signedIn() && isVendor() && (
        sameCompanyData(data) ||
        (data.keys().hasAny(['vendorUid']) && data.vendorUid == request.auth.uid) ||
        (data.keys().hasAny(['vendorId']) && data.vendorId == request.auth.uid)
      );
    }

    function roleMayBeTenantAssigned(roleValue) {
      return roleValue in [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'field_manager', 'Field Manager', 'FIELD_MANAGER',
        'sales_manager', 'Sales Manager', 'SALES_MANAGER',
        'dispatcher', 'Dispatcher', 'DISPATCHER',
        'hr', 'HR',
        'hr_manager', 'HR Manager', 'HR_MANAGER',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP',
        'technician', 'Technician', 'TECHNICIAN',
        'lead_technician', 'Lead Technician', 'LEAD_TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'lead_cleaner', 'Lead Cleaner', 'LEAD_CLEANER',
        'staff', 'Staff', 'STAFF',
        'field_staff', 'Field Staff', 'FIELD_STAFF',
        'crew_lead', 'Crew Lead', 'CREW_LEAD',
        'quality_control', 'Quality Control', 'QUALITY_CONTROL',
        'customer_support', 'Customer Support', 'CUSTOMER_SUPPORT',
        'customer', 'Customer', 'CUSTOMER',
        'vendor', 'Vendor', 'VENDOR',
        'lead_vendor', 'Lead Vendor', 'LEAD_VENDOR',
        'service_vendor', 'Service Vendor', 'SERVICE_VENDOR',
        'management_program', 'Management Program', 'MANAGEMENT_PROGRAM'
      ];
    }

    function staffAssignableRole(roleValue) {
      return roleValue in [
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'field_manager', 'Field Manager', 'FIELD_MANAGER',
        'sales_manager', 'Sales Manager', 'SALES_MANAGER',
        'dispatcher', 'Dispatcher', 'DISPATCHER',
        'hr', 'HR',
        'hr_manager', 'HR Manager', 'HR_MANAGER',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP',
        'technician', 'Technician', 'TECHNICIAN',
        'lead_technician', 'Lead Technician', 'LEAD_TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'lead_cleaner', 'Lead Cleaner', 'LEAD_CLEANER',
        'staff', 'Staff', 'STAFF',
        'field_staff', 'Field Staff', 'FIELD_STAFF',
        'crew_lead', 'Crew Lead', 'CREW_LEAD',
        'quality_control', 'Quality Control', 'QUALITY_CONTROL',
        'customer_support', 'Customer Support', 'CUSTOMER_SUPPORT'
      ];
    }

    function safeSelfUserCreate(userId) {
      return isSelf(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.role in ['customer', 'Customer', 'CUSTOMER']
        && request.resource.data.status == 'pending'
        && request.resource.data.approvalStatus == 'pending';
    }

    function safeSelfUserUpdate(userId) {
      return isSelf(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.status == resource.data.status
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'fullName', 'name', 'username', 'usernameLower',
          'phone', 'bio', 'notes', 'photoURL', 'themePreferences',
          'themePreferencesUpdatedAt', 'notificationPreferences', 'updatedAt'
        ]);
    }

    function safeTenantUserAdministration(userId) {
      return signedIn()
        && !isSelf(userId)
        && (isPlatformAdmin() || isTenantExecutive() || isManager())
        && roleMayBeTenantAssigned(request.resource.data.role)
        && (
          isPlatformAdmin() ||
          (sameCompanyData(resource.data) && sameCompanyData(request.resource.data))
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'approvalStatus', 'companyId', 'companyName',
          'companySlug', 'companyCategory', 'staffApplicationId',
          'approvedAt', 'approvedBy', 'approvedByEmail', 'approvedByName',
          'updatedAt', 'updatedBy', 'updatedByEmail', 'updatedByName'
        ]);
    }

    function safeCustomerLeadCreate() {
      return isCustomer()
        && request.resource.data.customerSubmitted == true
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByRole == 'customer'
        && request.resource.data.source == 'customer_portal'
        && request.resource.data.leadSource == 'customer_portal'
        && request.resource.data.status in ['new', 'dispatch_review']
        && request.resource.data.automationStatus in ['company_routed', 'needs_dispatch_review'];
    }

    function canReadLeadData(data) {
      return signedIn() && (
        isPlatformAdmin() ||
        (sameCompanyData(data) && isTenantLeadership()) ||
        assignedToMe(data) ||
        customerOwns(data) ||
        vendorOwns(data) ||
        (isSales() && sameCompanyData(data) && (
          (data.keys().hasAny(['createdBy']) && data.createdBy == request.auth.uid) ||
          (data.keys().hasAny(['createdByUid']) && data.createdByUid == request.auth.uid)
        ))
      );
    }

    function safeAssignedLeadUpdate() {
      return signedIn()
        && (assignedToMe(resource.data) || (isSales() && canReadLeadData(resource.data)))
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'notes', 'description', 'nextStep', 'updatedAt',
          'updatedBy', 'updatedByUid', 'updatedByName', 'staffClaimed',
          'staffClaimedBy', 'staffClaimedAt', 'syncStatus'
        ]);
    }

    function canReadJobData(data) {
      return signedIn() && (
        isPlatformAdmin() ||
        (sameCompanyData(data) && (isTenantLeadership() || isVendor())) ||
        assignedToMe(data) ||
        customerOwns(data)
      );
    }

    function safeAssignedJobUpdate() {
      return signedIn()
        && assignedToMe(resource.data)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'jobStatus', 'checklist', 'notes', 'completionNotes',
          'beforePhotos', 'afterPhotos', 'proofPhotos', 'startedAt',
          'arrivedAt', 'completedAt', 'updatedAt', 'updatedBy',
          'updatedByUid', 'staffClaimed', 'staffClaimedBy', 'staffClaimedAt'
        ]);
    }

    function canReadCustomerRecord(data) {
      return signedIn() && (
        isPlatformAdmin() ||
        customerOwns(data) ||
        (sameCompanyData(data) && isTenantLeadership()) ||
        vendorOwns(data)
      );
    }

    function validAuditCreate() {
      return signedIn()
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && (
          isPlatformAdmin() ||
          !request.resource.data.keys().hasAny(['companyId']) ||
          !hasCompanyId(request.resource.data.companyId) ||
          sameCompanyId(request.resource.data.companyId)
        );
    }

    function channelMeta(channelId) {
      return get(/databases/$(database)/documents/channels/_group_registry/messages/$(channelId)).data;
    }

    function channelExists(channelId) {
      return exists(/databases/$(database)/documents/channels/_group_registry/messages/$(channelId));
    }

    function canAccessChannel(channelId) {
      return signedIn() && channelExists(channelId) && (
        isPlatformAdmin() ||
        (
          sameCompanyData(channelMeta(channelId)) && (
            (channelMeta(channelId).keys().hasAny(['memberUids']) && request.auth.uid in channelMeta(channelId).memberUids) ||
            (channelMeta(channelId).keys().hasAny(['adminUids']) && request.auth.uid in channelMeta(channelId).adminUids) ||
            (channelMeta(channelId).keys().hasAny(['allowedRoles']) && userRole() in channelMeta(channelId).allowedRoles)
          )
        )
      );
    }

    match /users/{userId} {
      allow create: if isPlatformAdmin() || safeSelfUserCreate(userId);
      allow read: if signedIn() && (
        isSelf(userId) ||
        isPlatformAdmin() ||
        (sameCompanyData(resource.data) && isTenantLeadership())
      );
      allow update: if isPlatformAdmin() || safeSelfUserUpdate(userId) || safeTenantUserAdministration(userId);
      allow delete: if isPlatformAdmin() || (
        isTenantExecutive() && !isSelf(userId) && sameCompanyData(resource.data)
      );
    }

    match /companies/{companyId} {
      allow read: if signedIn() && (isPlatformAdmin() || sameCompanyId(companyId));
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyId(companyId));
      allow delete: if isPlatformAdmin();
    }

    match /dashboard_stats/{statsId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /company_stats/{companyId} {
      allow read: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyId(companyId));
      allow write: if false;
    }

    match /staff_applications/{applicationId} {
      allow create: if signedIn()
        && applicationId == request.auth.uid
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.verificationStatus == 'pending_review'
        && staffAssignableRole(request.resource.data.roleRequested);
      allow read: if signedIn() && (
        applicationId == request.auth.uid ||
        isPlatformAdmin() ||
        (sameCompanyData(resource.data) && isTenantLeadership())
      );
      allow update: if signedIn() && (
        (
          applicationId == request.auth.uid
          && resource.data.applicantUid == request.auth.uid
          && request.resource.data.applicantUid == resource.data.applicantUid
          && request.resource.data.roleRequested == resource.data.roleRequested
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'address', 'city', 'state', 'zip',
            'dateOfBirth', 'workAuthorization', 'hasDriversLicense',
            'driversLicenseState', 'hasReliableTransportation', 'availability',
            'experienceSummary', 'emergencyContactName', 'emergencyContactPhone',
            'attachments', 'status', 'verificationStatus', 'updatedAt'
          ])
        ) ||
        (
          (isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(resource.data)))
          && request.resource.data.applicantUid == resource.data.applicantUid
          && request.resource.data.roleRequested == resource.data.roleRequested
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'verificationStatus', 'reviewNotes', 'reviewedAt',
            'reviewedBy', 'reviewedByEmail', 'reviewedByName', 'approvedAt',
            'approvedBy', 'approvedByEmail', 'approvedByName', 'rejectedAt',
            'rejectedBy', 'rejectedByEmail', 'rejectedByName', 'updatedAt'
          ])
        )
      );
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /staff_profiles/{profileId} {
      allow read: if signedIn() && (
        profileId == request.auth.uid ||
        isPlatformAdmin() ||
        (sameCompanyData(resource.data) && isTenantLeadership())
      );
      allow create, update: if signedIn()
        && request.resource.data.uid == profileId
        && request.resource.data.userId == profileId
        && staffAssignableRole(request.resource.data.role)
        && request.resource.data.status in ['active', 'inactive', 'suspended', 'approved']
        && (isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(request.resource.data)));
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /invites/{inviteId} {
      allow read: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(resource.data));
      allow create: if signedIn()
        && request.resource.data.type == 'staff_application'
        && request.resource.data.status == 'active'
        && staffAssignableRole(request.resource.data.roleSuggested)
        && request.resource.data.createdBy == request.auth.uid
        && (isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(request.resource.data)));
      allow update, delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isPlatformAdmin() ||
        resource.data.userId == request.auth.uid ||
        (sameCompanyData(resource.data) && isTenantLeadership())
      );
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isPlatformAdmin() || (sameCompanyData(resource.data) && isTenantLeadership()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt', 'updatedAt']);
      allow create, delete: if false;
    }

    match /history_timeline/{logId} {
      allow read: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(resource.data));
      allow create: if validAuditCreate();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isPlatformAdmin() || (
        isTenantLeadership() && (
          (resource.data.keys().hasAny(['companyId']) && sameCompanyId(resource.data.companyId)) ||
          (resource.data.keys().hasAny(['targetCompanyId']) && sameCompanyId(resource.data.targetCompanyId))
        )
      );
      allow create: if validAuditCreate();
      allow update, delete: if false;
    }

    match /operation_events/{eventDocId} {
      allow read: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(resource.data));
      allow create: if signedIn()
        && (isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(request.resource.data)))
        && request.resource.data.persistedAt == request.time;
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      allow read: if canReadLeadData(resource.data);
      allow create: if safeCustomerLeadCreate() || (
        signedIn() && (isPlatformAdmin() || (isTenantWorkforce() && sameCompanyData(request.resource.data)))
      );
      allow update: if safeAssignedLeadUpdate() || isPlatformAdmin() || (
        isTenantLeadership() && sameCompanyData(resource.data) && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));

      match /activities/{activityId} {
        allow read: if canReadLeadData(get(/databases/$(database)/documents/leads/$(leadId)).data);
        allow create: if canReadLeadData(get(/databases/$(database)/documents/leads/$(leadId)).data)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isPlatformAdmin() || (
          isTenantExecutive() && sameCompanyData(get(/databases/$(database)/documents/leads/$(leadId)).data)
        );
      }
    }

    match /lead_activities/{activityId} {
      allow read: if resource.data.keys().hasAny(['leadId'])
        && exists(/databases/$(database)/documents/leads/$(resource.data.leadId))
        && canReadLeadData(get(/databases/$(database)/documents/leads/$(resource.data.leadId)).data);
      allow create: if request.resource.data.keys().hasAny(['leadId'])
        && exists(/databases/$(database)/documents/leads/$(request.resource.data.leadId))
        && canReadLeadData(get(/databases/$(database)/documents/leads/$(request.resource.data.leadId)).data)
        && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if isPlatformAdmin();
    }

    match /jobs/{jobId} {
      allow read: if canReadJobData(resource.data);
      allow create: if signedIn() && (
        isPlatformAdmin() ||
        (isTenantLeadership() && sameCompanyData(request.resource.data)) ||
        (isVendor() && vendorOwns(request.resource.data))
      );
      allow update: if safeAssignedJobUpdate() || isPlatformAdmin() || (
        (isTenantLeadership() || isVendor())
        && sameCompanyData(resource.data)
        && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /customer_services/{serviceId} {
      allow read: if canReadCustomerRecord(resource.data);
      allow create: if signedIn() && (
        (isCustomer() && customerOwns(request.resource.data)) ||
        isPlatformAdmin() ||
        (isTenantLeadership() && sameCompanyData(request.resource.data))
      );
      allow update: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(resource.data));
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /services/{serviceId} {
      allow read: if signedIn() && (
        isPlatformAdmin() ||
        sameCompanyData(resource.data) ||
        (resource.data.keys().hasAny(['isPublic']) && resource.data.isPublic == true
          && resource.data.keys().hasAny(['status']) && resource.data.status == 'active')
      );
      allow create: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(request.resource.data));
      allow update: if isPlatformAdmin() || (
        isTenantLeadership() && sameCompanyData(resource.data) && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /subscriptions/{subscriptionId} {
      allow read: if canReadCustomerRecord(resource.data);
      allow create: if signedIn() && (
        (isCustomer() && customerOwns(request.resource.data)) ||
        isPlatformAdmin() ||
        (isTenantLeadership() && sameCompanyData(request.resource.data))
      );
      allow update: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(resource.data));
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && (
        isPlatformAdmin() || customerOwns(resource.data) ||
        (sameCompanyData(resource.data) && isTenantExecutive())
      );
      allow create, update: if isPlatformAdmin() || (
        isTenantExecutive() && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if canReadCustomerRecord(resource.data);
      allow create: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(request.resource.data));
      allow update: if isPlatformAdmin() || (
        isTenantLeadership() && sameCompanyData(resource.data) && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /transactions/{transactionId} {
      allow read: if signedIn() && (
        isPlatformAdmin() || customerOwns(resource.data) ||
        (sameCompanyData(resource.data) && isTenantExecutive())
      );
      allow create, update: if isPlatformAdmin() || (
        isTenantExecutive() && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if signedIn() && (
        isPlatformAdmin() ||
        resource.data.userId == request.auth.uid ||
        vendorOwns(resource.data) ||
        (sameCompanyData(resource.data) && isTenantExecutive())
      );
      allow create, update: if isPlatformAdmin() || (
        isTenantExecutive() && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin();
    }

    match /marketplace_payouts/{payoutId} {
      allow read: if signedIn() && (
        isPlatformAdmin() || vendorOwns(resource.data) ||
        (sameCompanyData(resource.data) && isTenantExecutive())
      );
      allow create, update, delete: if isPlatformAdmin();
    }

    match /stripe_webhook_events/{eventId} {
      allow read: if isPlatformAdmin();
      allow write: if false;
    }

    match /stripe_sessions/{sessionId} {
      allow read: if signedIn() && (
        isPlatformAdmin() || customerOwns(resource.data) ||
        (sameCompanyData(resource.data) && isTenantExecutive())
      );
      allow write: if false;
    }

    match /revenue_analytics/{snapshotId} {
      allow read: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
      allow create, update: if isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    match /customer_notifications/{notificationId} {
      allow read: if canReadCustomerRecord(resource.data);
      allow create: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(request.resource.data));
      allow update: if canReadCustomerRecord(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'readAtMs', 'archivedAtMs', 'dismissedAtMs', 'updatedAtMs'
        ]);
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /customer_message_threads/{threadId} {
      allow read: if canReadCustomerRecord(resource.data);
      allow create: if signedIn() && (
        (isCustomer() && customerOwns(request.resource.data)) ||
        isPlatformAdmin() ||
        (isTenantLeadership() && sameCompanyData(request.resource.data))
      );
      allow update: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(resource.data));
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));

      match /messages/{messageId} {
        function parentThread() {
          return get(/databases/$(database)/documents/customer_message_threads/$(threadId)).data;
        }
        allow read: if canReadCustomerRecord(parentThread());
        allow create: if canReadCustomerRecord(parentThread())
          && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isPlatformAdmin() || (
          isTenantExecutive() && sameCompanyData(parentThread())
        );
      }
    }

    match /customer_service_history/{historyId} {
      allow read: if canReadCustomerRecord(resource.data);
      allow create, update: if isPlatformAdmin() || (isTenantLeadership() && sameCompanyData(request.resource.data));
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /payroll_runs/{runId} {
      allow read: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
      allow create, update: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(request.resource.data));
      allow delete: if isPlatformAdmin();
    }

    match /dispatch_assignments/{assignmentId} {
      allow read: if signedIn() && (
        isPlatformAdmin() ||
        (sameCompanyData(resource.data) && isTenantLeadership()) ||
        assignedToMe(resource.data)
      );
      allow create: if isPlatformAdmin() || (
        isTenantLeadership() && sameCompanyData(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
      );
      allow update: if isPlatformAdmin() || (
        isTenantLeadership() && sameCompanyData(resource.data) && sameCompanyData(request.resource.data)
      );
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /presence/{userId} {
      allow read: if signedIn() && (
        isSelf(userId) || isPlatformAdmin() ||
        (isTenantLeadership() && sameCompanyData(resource.data))
      );
      allow create, update: if isSelf(userId)
        && sameCompanyData(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSelf(userId) || isPlatformAdmin() || (
        isTenantExecutive() && sameCompanyData(resource.data)
      );
    }

    match /workforce_locations/{userId} {
      allow read: if signedIn() && (
        isSelf(userId) || isPlatformAdmin() ||
        (isTenantLeadership() && sameCompanyData(resource.data))
      );
      allow create, update: if isSelf(userId)
        && sameCompanyData(request.resource.data)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSelf(userId) || isPlatformAdmin() || (
        isTenantExecutive() && sameCompanyData(resource.data)
      );
    }

    match /channels/_group_registry/messages/{conversationId} {
      allow read: if signedIn() && (
        isPlatformAdmin() ||
        (sameCompanyData(resource.data) && (
          (resource.data.keys().hasAny(['memberUids']) && request.auth.uid in resource.data.memberUids) ||
          (resource.data.keys().hasAny(['adminUids']) && request.auth.uid in resource.data.adminUids) ||
          (resource.data.keys().hasAny(['allowedRoles']) && userRole() in resource.data.allowedRoles)
        ))
      );
      allow create: if signedIn()
        && sameCompanyData(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.keys().hasAny(['memberUids'])
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn() && (
        isPlatformAdmin() ||
        (sameCompanyData(resource.data) && (
          (resource.data.keys().hasAny(['adminUids']) && request.auth.uid in resource.data.adminUids) ||
          isTenantLeadership()
        ))
      ) && request.resource.data.companyId == resource.data.companyId;
      allow delete: if isPlatformAdmin() || (isTenantExecutive() && sameCompanyData(resource.data));
    }

    match /channels/{channelId}/messages/{messageId} {
      allow read: if canAccessChannel(channelId);
      allow create: if canAccessChannel(channelId)
        && request.resource.data.senderUid == request.auth.uid
        && (
          (request.resource.data.keys().hasAny(['text'])
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 10000)
          || request.resource.data.keys().hasAny(['imageUrl'])
        );
      allow update: if canAccessChannel(channelId)
        && request.resource.data.senderUid == resource.data.senderUid
        && (isPlatformAdmin() || resource.data.senderUid == request.auth.uid);
      allow delete: if canAccessChannel(channelId)
        && (isPlatformAdmin() || resource.data.senderUid == request.auth.uid);

      match /reactions/{userId} {
        allow read: if canAccessChannel(channelId);
        allow create, update: if canAccessChannel(channelId)
          && request.auth.uid == userId
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.emoji is string;
        allow delete: if canAccessChannel(channelId)
          && (request.auth.uid == userId || isPlatformAdmin());
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

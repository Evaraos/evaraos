rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return currentUserExists() ? currentUser().data.role : null;
    }

    function userCompanyId() {
      return currentUserExists() ? currentUser().data.companyId : null;
    }

    function isOwnerOrAdmin() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN'
      ];
    }

    function isOperationsPlus() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR'
      ];
    }

    function isManagerPlus() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function isCompanyDispatcher() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function isStaffDispatcher() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'technician', 'Technician', 'TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'staff', 'Staff', 'STAFF',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function isStaffAssignableRole(roleValue) {
      return roleValue in [
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP',
        'technician', 'Technician', 'TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'staff', 'Staff', 'STAFF'
      ];
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function safeSelfUserCreate(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'pending'
        && request.resource.data.approvalStatus == 'pending';
    }

    function safeSelfUserUpdate(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.companyName == resource.data.companyName
        && request.resource.data.status == resource.data.status
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'fullName',
          'name',
          'username',
          'usernameLower',
          'phone',
          'bio',
          'notes',
          'photoURL',
          'themePreferences',
          'themePreferencesUpdatedAt',
          'notificationPreferences',
          'updatedAt'
        ]);
    }

    function safeStaffApprovalUserUpdate(userId) {
      return isOperationsPlus()
        && !ownsUserDoc(userId)
        && isStaffAssignableRole(request.resource.data.role)
        && request.resource.data.status in ['active', 'approved']
        && request.resource.data.approvalStatus == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'status',
          'approvalStatus',
          'companyId',
          'companyName',
          'companySlug',
          'companyCategory',
          'staffApplicationId',
          'approvedAt',
          'approvedBy',
          'approvedByEmail',
          'approvedByName',
          'updatedAt',
          'updatedBy',
          'updatedByEmail',
          'updatedByName'
        ]);
    }

    function validAuditCreate() {
      return signedIn()
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function sameCompanyOrPlatform(recordCompanyId) {
      return recordCompanyId == null ||
        recordCompanyId == '' ||
        userCompanyId() == null ||
        userCompanyId() == '' ||
        recordCompanyId == userCompanyId();
    }

    function companyClaimUpdate() {
      return isCompanyDispatcher()
        && resource.data.companyClaimed != true
        && request.resource.data.companyClaimed == true
        && request.resource.data.companyClaimedBy == request.auth.uid
        && request.resource.data.status == 'claimed'
        && sameCompanyOrPlatform(resource.data.companyId);
    }

    function staffClaimUpdate() {
      return isStaffDispatcher()
        && resource.data.companyClaimed == true
        && resource.data.staffClaimed != true
        && request.resource.data.staffClaimed == true
        && request.resource.data.staffClaimedBy == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && sameCompanyOrPlatform(resource.data.companyId);
    }

    function operationsJobUpdate() {
      return isOperationsPlus() && sameCompanyOrPlatform(resource.data.companyId);
    }

    function safeStaffInviteCreate() {
      return isOperationsPlus()
        && request.resource.data.type == 'staff_application'
        && request.resource.data.status == 'active'
        && isStaffAssignableRole(request.resource.data.roleSuggested)
        && request.resource.data.createdBy == request.auth.uid;
    }

    function safeStaffApplicationCreate(applicationId) {
      return signedIn()
        && applicationId == request.auth.uid
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.verificationStatus == 'pending_review'
        && isStaffAssignableRole(request.resource.data.roleRequested);
    }

    function safeStaffApplicationSelfUpdate(applicationId) {
      return signedIn()
        && applicationId == request.auth.uid
        && resource.data.applicantUid == request.auth.uid
        && resource.data.status in ['submitted', 'needs_more_info']
        && request.resource.data.status in ['submitted', 'needs_more_info']
        && request.resource.data.applicantUid == resource.data.applicantUid
        && request.resource.data.roleRequested == resource.data.roleRequested
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'phone',
          'address',
          'city',
          'state',
          'zip',
          'dateOfBirth',
          'workAuthorization',
          'hasDriversLicense',
          'driversLicenseState',
          'hasReliableTransportation',
          'availability',
          'experienceSummary',
          'emergencyContactName',
          'emergencyContactPhone',
          'attachments',
          'status',
          'verificationStatus',
          'updatedAt'
        ]);
    }

    function safeStaffApplicationReviewUpdate() {
      return isOperationsPlus()
        && request.resource.data.applicantUid == resource.data.applicantUid
        && request.resource.data.roleRequested == resource.data.roleRequested
        && request.resource.data.status in ['submitted', 'needs_more_info', 'approved', 'rejected']
        && request.resource.data.verificationStatus in ['pending_review', 'verified', 'rejected', 'needs_more_info']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'verificationStatus',
          'reviewNotes',
          'reviewedAt',
          'reviewedBy',
          'reviewedByEmail',
          'reviewedByName',
          'approvedAt',
          'approvedBy',
          'approvedByEmail',
          'approvedByName',
          'rejectedAt',
          'rejectedBy',
          'rejectedByEmail',
          'rejectedByName',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if isOwnerOrAdmin() || safeSelfUserCreate(userId);
      allow read: if signedIn() && (ownsUserDoc(userId) || isManagerPlus());
      allow update: if isOwnerOrAdmin() || safeSelfUserUpdate(userId) || safeStaffApprovalUserUpdate(userId);
      allow delete: if isOwnerOrAdmin() && !ownsUserDoc(userId);
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /dashboard_stats/{statsId} {
      allow read: if isManagerPlus();
      allow create, update, delete: if false;
    }

    match /company_stats/{companyId} {
      allow read: if isManagerPlus() && sameCompanyOrPlatform(companyId);
      allow create, update, delete: if false;
    }

    match /staff_applications/{applicationId} {
      allow create: if safeStaffApplicationCreate(applicationId);
      allow read: if signedIn() && (isOperationsPlus() || applicationId == request.auth.uid);
      allow update: if safeStaffApplicationSelfUpdate(applicationId) || safeStaffApplicationReviewUpdate();
      allow delete: if isOwnerOrAdmin();
    }

    match /invites/{inviteId} {
      allow read: if isOperationsPlus();
      allow create: if safeStaffInviteCreate();
      allow update, delete: if isOwnerOrAdmin();
    }

    match /history_timeline/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if validAuditCreate();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if validAuditCreate();
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      allow read: if signedIn();
      allow create, update: if isManagerPlus();
      allow delete: if isOwnerOrAdmin();

      match /activities/{activityId} {
        allow read: if signedIn();
        allow create: if isManagerPlus();
        allow update, delete: if isOwnerOrAdmin();
      }
    }

    match /lead_activities/{activityId} {
      allow read: if signedIn();
      allow create: if isManagerPlus();
      allow update, delete: if isOwnerOrAdmin();
    }

    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if isManagerPlus();
      allow update: if isOwnerOrAdmin() || operationsJobUpdate() || companyClaimUpdate() || staffClaimUpdate();
      allow delete: if isOwnerOrAdmin();
    }

    match /customer_services/{serviceId} {
      allow read: if signedIn();
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn();
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isOwnerOrAdmin();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

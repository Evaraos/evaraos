rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return currentUserExists() ? currentUser().data.role : null;
    }

    function userCompanyId() {
      return currentUserExists() ? currentUser().data.companyId : null;
    }

    function isOwnerOrAdmin() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN'
      ];
    }

    function isManagerPlus() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP',
        'technician', 'Technician', 'TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'staff', 'Staff', 'STAFF'
      ];
    }

    function isCompanyDispatcher() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function isStaffDispatcher() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'technician', 'Technician', 'TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'staff', 'Staff', 'STAFF',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function companyClaimUpdate() {
      return isCompanyDispatcher()
        && resource.data.companyClaimed != true
        && request.resource.data.companyClaimed == true
        && request.resource.data.companyClaimedBy == request.auth.uid
        && request.resource.data.status == 'claimed';
    }

    function staffClaimUpdate() {
      return isStaffDispatcher()
        && resource.data.companyClaimed == true
        && resource.data.staffClaimed != true
        && request.resource.data.staffClaimed == true
        && request.resource.data.staffClaimedBy == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && (
          resource.data.companyId == null ||
          userCompanyId() == null ||
          resource.data.companyId == userCompanyId()
        );
    }

    match /users/{userId} {
      allow create: if signedIn() && (ownsUserDoc(userId) || isOwnerOrAdmin());
      allow read: if signedIn() && (ownsUserDoc(userId) || isManagerPlus());
      allow update: if signedIn() && (ownsUserDoc(userId) || isOwnerOrAdmin());
      allow delete: if isOwnerOrAdmin() && !ownsUserDoc(userId);
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /history_timeline/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isOwnerOrAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      allow read: if signedIn();
      allow create, update, delete: if isManagerPlus();

      match /activities/{activityId} {
        allow read: if signedIn();
        allow create: if isManagerPlus();
        allow update, delete: if isOwnerOrAdmin();
      }
    }

    match /lead_activities/{activityId} {
      allow read: if signedIn();
      allow create: if isManagerPlus();
      allow update, delete: if isOwnerOrAdmin();
    }

    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if isManagerPlus();
      allow update: if isOwnerOrAdmin() || companyClaimUpdate() || staffClaimUpdate() || isManagerPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /customer_services/{serviceId} {
      allow read: if signedIn();
      allow create, update, delete: if isManagerPlus();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update, delete: if isManagerPlus();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn();
      allow create, update, delete: if isManagerPlus();
    }

    match /payments/{paymentId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

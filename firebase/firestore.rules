rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUserExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return currentUserExists() ? currentUser().data.role : null;
    }

    function userCompanyId() {
      return currentUserExists() ? currentUser().data.companyId : null;
    }

    function hasUserCompany() {
      return userCompanyId() != null && userCompanyId() != '';
    }

    function hasRecordCompany(recordCompanyId) {
      return recordCompanyId != null && recordCompanyId != '';
    }

    function isCustomer() {
      return signedIn() && userRole() in ['customer', 'Customer', 'CUSTOMER'];
    }

    function isOwnerOrAdmin() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN'
      ];
    }

    function isGovernancePlus() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR'
      ];
    }

    function isOperationsPlus() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'hr', 'HR',
        'hr_manager', 'HR Manager', 'HR_MANAGER'
      ];
    }

    function isManagerPlus() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'super_admin', 'Super Admin', 'SUPER_ADMIN',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'field_manager', 'Field Manager', 'FIELD_MANAGER',
        'sales_manager', 'Sales Manager', 'SALES_MANAGER',
        'dispatcher', 'Dispatcher', 'DISPATCHER',
        'hr', 'HR',
        'hr_manager', 'HR Manager', 'HR_MANAGER',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function isCompanyDispatcher() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'field_manager', 'Field Manager', 'FIELD_MANAGER',
        'dispatcher', 'Dispatcher', 'DISPATCHER',
        'sales_manager', 'Sales Manager', 'SALES_MANAGER',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP'
      ];
    }

    function isStaffDispatcher() {
      return signedIn() && userRole() in [
        'owner', 'Owner', 'OWNER',
        'admin', 'Admin', 'ADMIN',
        'manager', 'Manager', 'MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'operations_coordinator', 'Operations Coordinator', 'OPERATIONS_COORDINATOR',
        'field_manager', 'Field Manager', 'FIELD_MANAGER',
        'dispatcher', 'Dispatcher', 'DISPATCHER',
        'quality_control', 'Quality Control', 'QUALITY_CONTROL',
        'technician', 'Technician', 'TECHNICIAN',
        'lead_technician', 'Lead Technician', 'LEAD_TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'lead_cleaner', 'Lead Cleaner', 'LEAD_CLEANER',
        'staff', 'Staff', 'STAFF',
        'field_staff', 'Field Staff', 'FIELD_STAFF',
        'crew_lead', 'Crew Lead', 'CREW_LEAD',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP',
        'customer_support', 'Customer Support', 'CUSTOMER_SUPPORT'
      ];
    }

    function isStaffAssignableRole(roleValue) {
      return roleValue in [
        'hr', 'HR',
        'hr_manager', 'HR Manager', 'HR_MANAGER',
        'operations_manager', 'Operations Manager', 'OPERATIONS_MANAGER',
        'dispatcher', 'Dispatcher', 'DISPATCHER',
        'field_manager', 'Field Manager', 'FIELD_MANAGER',
        'sales_manager', 'Sales Manager', 'SALES_MANAGER',
        'customer_support', 'Customer Support', 'CUSTOMER_SUPPORT',
        'quality_control', 'Quality Control', 'QUALITY_CONTROL',
        'sales', 'Sales', 'SALES',
        'sales_rep', 'Sales Rep', 'SALES_REP',
        'technician', 'Technician', 'TECHNICIAN',
        'lead_technician', 'Lead Technician', 'LEAD_TECHNICIAN',
        'cleaner', 'Cleaner', 'CLEANER',
        'lead_cleaner', 'Lead Cleaner', 'LEAD_CLEANER',
        'staff', 'Staff', 'STAFF',
        'field_staff', 'Field Staff', 'FIELD_STAFF',
        'crew_lead', 'Crew Lead', 'CREW_LEAD'
      ];
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function sameCompanyOrPlatform(recordCompanyId) {
      return isOwnerOrAdmin() || (
        hasUserCompany() &&
        hasRecordCompany(recordCompanyId) &&
        recordCompanyId == userCompanyId()
      );
    }

    function assignedToMe(data) {
      return signedIn() && (
        (data.keys().hasAny(['assignedTo']) && request.auth.uid in data.assignedTo) ||
        (data.keys().hasAny(['assignedTeamIds']) && request.auth.uid in data.assignedTeamIds) ||
        (data.keys().hasAny(['assignedToUid']) && data.assignedToUid == request.auth.uid) ||
        (data.keys().hasAny(['assignedRep']) && data.assignedRep == request.auth.uid) ||
        (data.keys().hasAny(['staffClaimedBy']) && data.staffClaimedBy == request.auth.uid)
      );
    }

    function leadBelongsToMe(data) {
      return signedIn() && (
        data.createdBy == request.auth.uid ||
        data.createdByUid == request.auth.uid ||
        data.customerUid == request.auth.uid ||
        assignedToMe(data)
      );
    }

    function safeCustomerLeadCreate() {
      return isCustomer()
        && request.resource.data.customerSubmitted == true
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByRole == 'customer'
        && request.resource.data.source == 'customer_portal'
        && request.resource.data.leadSource == 'customer_portal'
        && request.resource.data.status in ['new', 'dispatch_review']
        && request.resource.data.automationStatus in ['company_routed', 'needs_dispatch_review'];
    }

    function safeAssignedStaffLeadUpdate() {
      return isStaffDispatcher()
        && assignedToMe(resource.data)
        && sameCompanyOrPlatform(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'notes',
          'description',
          'nextStep',
          'updatedAt',
          'updatedBy',
          'updatedByUid',
          'updatedByName',
          'staffClaimed',
          'staffClaimedBy',
          'staffClaimedAt',
          'syncStatus'
        ]);
    }

    function canReadLead() {
      return signedIn() && (
        isManagerPlus() ||
        leadBelongsToMe(resource.data) ||
        sameCompanyOrPlatform(resource.data.companyId)
      );
    }

    function canCreateLead() {
      return isManagerPlus() || safeCustomerLeadCreate();
    }

    function canUpdateLead() {
      return isManagerPlus() || safeAssignedStaffLeadUpdate();
    }

    function canDeleteLead() {
      return isOwnerOrAdmin() || (isOperationsPlus() && sameCompanyOrPlatform(resource.data.companyId));
    }

    function safeSelfUserCreate(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.role == 'customer'
        && request.resource.data.status == 'pending'
        && request.resource.data.approvalStatus == 'pending';
    }

    function safeSelfUserUpdate(userId) {
      return ownsUserDoc(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.companyName == resource.data.companyName
        && request.resource.data.status == resource.data.status
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'fullName',
          'name',
          'username',
          'usernameLower',
          'phone',
          'bio',
          'notes',
          'photoURL',
          'themePreferences',
          'themePreferencesUpdatedAt',
          'notificationPreferences',
          'updatedAt'
        ]);
    }

    function safeStaffApprovalUserUpdate(userId) {
      return isOperationsPlus()
        && !ownsUserDoc(userId)
        && isStaffAssignableRole(request.resource.data.role)
        && request.resource.data.status in ['active', 'approved']
        && request.resource.data.approvalStatus == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'status',
          'approvalStatus',
          'companyId',
          'companyName',
          'companySlug',
          'companyCategory',
          'staffApplicationId',
          'approvedAt',
          'approvedBy',
          'approvedByEmail',
          'approvedByName',
          'updatedAt',
          'updatedBy',
          'updatedByEmail',
          'updatedByName'
        ]);
    }

    function safeStaffProfileWrite(profileId) {
      return isOperationsPlus()
        && request.resource.data.uid == profileId
        && request.resource.data.userId == profileId
        && isStaffAssignableRole(request.resource.data.role)
        && request.resource.data.status in ['active', 'inactive', 'suspended', 'approved'];
    }

    function validAuditCreate() {
      return signedIn()
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function validOperationEventCreate() {
      return isGovernancePlus()
        && request.resource.data.keys().hasOnly([
          'eventId',
          'eventType',
          'timestamp',
          'source',
          'actor',
          'severity',
          'correlationId',
          'payload',
          'metadata',
          'persistedAt'
        ])
        && request.resource.data.eventType is string
        && request.resource.data.timestamp is number
        && request.resource.data.source is string
        && request.resource.data.severity in ['critical', 'warning', 'info', 'success']
        && request.resource.data.payload is map
        && request.resource.data.metadata is map
        && request.resource.data.persistedAt == request.time;
    }

    function companyClaimUpdate() {
      return isCompanyDispatcher()
        && resource.data.companyClaimed != true
        && request.resource.data.companyClaimed == true
        && request.resource.data.companyClaimedBy == request.auth.uid
        && request.resource.data.status == 'claimed'
        && sameCompanyOrPlatform(resource.data.companyId);
    }

    function staffClaimUpdate() {
      return isStaffDispatcher()
        && resource.data.companyClaimed == true
        && resource.data.staffClaimed != true
        && request.resource.data.staffClaimed == true
        && request.resource.data.staffClaimedBy == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && sameCompanyOrPlatform(resource.data.companyId);
    }

    function operationsJobUpdate() {
      return isOperationsPlus() && sameCompanyOrPlatform(resource.data.companyId);
    }

    function safeStaffInviteCreate() {
      return isOperationsPlus()
        && request.resource.data.type == 'staff_application'
        && request.resource.data.status == 'active'
        && isStaffAssignableRole(request.resource.data.roleSuggested)
        && request.resource.data.createdBy == request.auth.uid;
    }

    function safeStaffApplicationCreate(applicationId) {
      return signedIn()
        && applicationId == request.auth.uid
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.verificationStatus == 'pending_review'
        && isStaffAssignableRole(request.resource.data.roleRequested);
    }

    function safeStaffApplicationSelfUpdate(applicationId) {
      return signedIn()
        && applicationId == request.auth.uid
        && resource.data.applicantUid == request.auth.uid
        && resource.data.status in ['submitted', 'needs_more_info']
        && request.resource.data.status in ['submitted', 'needs_more_info']
        && request.resource.data.applicantUid == resource.data.applicantUid
        && request.resource.data.roleRequested == resource.data.roleRequested
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName',
          'phone',
          'address',
          'city',
          'state',
          'zip',
          'dateOfBirth',
          'workAuthorization',
          'hasDriversLicense',
          'driversLicenseState',
          'hasReliableTransportation',
          'availability',
          'experienceSummary',
          'emergencyContactName',
          'emergencyContactPhone',
          'attachments',
          'status',
          'verificationStatus',
          'updatedAt'
        ]);
    }

    function safeStaffApplicationReviewUpdate() {
      return isOperationsPlus()
        && request.resource.data.applicantUid == resource.data.applicantUid
        && request.resource.data.roleRequested == resource.data.roleRequested
        && request.resource.data.status in ['submitted', 'needs_more_info', 'approved', 'rejected']
        && request.resource.data.verificationStatus in ['pending_review', 'verified', 'rejected', 'needs_more_info']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'verificationStatus',
          'reviewNotes',
          'reviewedAt',
          'reviewedBy',
          'reviewedByEmail',
          'reviewedByName',
          'approvedAt',
          'approvedBy',
          'approvedByEmail',
          'approvedByName',
          'rejectedAt',
          'rejectedBy',
          'rejectedByEmail',
          'rejectedByName',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if isOwnerOrAdmin() || safeSelfUserCreate(userId);
      allow read: if signedIn() && (ownsUserDoc(userId) || isManagerPlus());
      allow update: if isOwnerOrAdmin() || safeSelfUserUpdate(userId) || safeStaffApprovalUserUpdate(userId);
      allow delete: if isOwnerOrAdmin() && !ownsUserDoc(userId);
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /dashboard_stats/{statsId} {
      allow read: if isManagerPlus();
      allow create, update, delete: if false;
    }

    match /company_stats/{companyId} {
      allow read: if isManagerPlus() && sameCompanyOrPlatform(companyId);
      allow create, update, delete: if false;
    }

    match /staff_applications/{applicationId} {
      allow create: if safeStaffApplicationCreate(applicationId);
      allow read: if signedIn() && (isOperationsPlus() || applicationId == request.auth.uid);
      allow update: if safeStaffApplicationSelfUpdate(applicationId) || safeStaffApplicationReviewUpdate();
      allow delete: if isOwnerOrAdmin();
    }

    match /staff_profiles/{profileId} {
      allow read: if signedIn() && (isOperationsPlus() || profileId == request.auth.uid);
      allow create, update: if safeStaffProfileWrite(profileId);
      allow delete: if isOwnerOrAdmin();
    }

    match /invites/{inviteId} {
      allow read: if isOperationsPlus();
      allow create: if safeStaffInviteCreate();
      allow update, delete: if isOwnerOrAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (
        isOwnerOrAdmin() ||
        resource.data.userId == request.auth.uid ||
        sameCompanyOrPlatform(resource.data.companyId)
      );
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isOwnerOrAdmin()
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt', 'updatedAt']);
      allow create, delete: if false;
    }

    match /history_timeline/{logId} {
      allow read: if isGovernancePlus();
      allow create: if validAuditCreate();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isGovernancePlus();
      allow create: if validAuditCreate();
      allow update, delete: if false;
    }

    match /operation_events/{eventDocId} {
      allow read: if isGovernancePlus();
      allow create: if validOperationEventCreate();
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      allow read: if canReadLead();
      allow create: if canCreateLead();
      allow update: if canUpdateLead();
      allow delete: if canDeleteLead();

      match /activities/{activityId} {
        allow read: if canReadLead();
        allow create: if isManagerPlus() || (isStaffDispatcher() && assignedToMe(get(/databases/$(database)/documents/leads/$(leadId)).data));
        allow update, delete: if isOwnerOrAdmin();
      }
    }

    match /lead_activities/{activityId} {
      allow read: if signedIn();
      allow create: if isManagerPlus() || isStaffDispatcher();
      allow update, delete: if isOwnerOrAdmin();
    }

    match /jobs/{jobId} {
      allow read: if signedIn();
      allow create: if isManagerPlus();
      allow update: if isOwnerOrAdmin() || operationsJobUpdate() || companyClaimUpdate() || staffClaimUpdate();
      allow delete: if isOwnerOrAdmin();
    }

    match /customer_services/{serviceId} {
      allow read: if signedIn();
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if signedIn();
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isOwnerOrAdmin();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if signedIn() && (
        isManagerPlus() ||
        resource.data.customerUid == request.auth.uid
      );
      allow create, update: if isManagerPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isManagerPlus();
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /payouts/{payoutId} {
      allow read: if isOwnerOrAdmin() || (
        signedIn() && resource.data.userId == request.auth.uid
      );
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /marketplace_payouts/{payoutId} {
      allow read: if isOwnerOrAdmin() || isOperationsPlus();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();
    }

    match /stripe_webhook_events/{eventId} {
      allow read: if isOwnerOrAdmin();
      allow create, update, delete: if false;
    }

    match /stripe_sessions/{sessionId} {
      allow read: if isOwnerOrAdmin() || isOperationsPlus();
      allow create, update, delete: if false;
    }

    match /revenue_analytics/{snapshotId} {
      allow read: if isOwnerOrAdmin() || isOperationsPlus();
      allow create, update: if isOwnerOrAdmin();
      allow delete: if isOwnerOrAdmin();
    }

    match /customer_notifications/{notificationId} {
      allow read: if signedIn() && (
        isOperationsPlus() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isOperationsPlus();
      allow update: if signedIn() && (
        isOperationsPlus() ||
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'readAtMs',
        'archivedAtMs',
        'dismissedAtMs',
        'updatedAtMs'
      ]);
      allow delete: if isOwnerOrAdmin();
    }

    match /customer_message_threads/{threadId} {
      allow read: if signedIn() && (
        isOperationsPlus() ||
        resource.data.customerId == request.auth.uid
      );
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isOperationsPlus() ||
          get(/databases/$(database)/documents/customer_message_threads/$(threadId)).data.customerId == request.auth.uid
        );
        allow create: if signedIn() && (
          isOperationsPlus() ||
          get(/databases/$(database)/documents/customer_message_threads/$(threadId)).data.customerId == request.auth.uid
        );
        allow update, delete: if isOwnerOrAdmin();
      }
    }

    match /customer_service_history/{historyId} {
      allow read: if signedIn() && (
        isOperationsPlus() ||
        resource.data.customerId == request.auth.uid
      );
      allow create, update: if isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /payroll_runs/{runId} {
      allow read: if isOperationsPlus();
      allow create, update, delete: if isOwnerOrAdmin();
    }

    match /dispatch_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create: if isManagerPlus() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isManagerPlus() || isOperationsPlus();
      allow delete: if isOwnerOrAdmin();
    }

    match /presence/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isOwnerOrAdmin() || ownsUserDoc(userId);
    }

    match /workforce_locations/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isOwnerOrAdmin() || ownsUserDoc(userId);
    }

    match /channels/{channelId}/messages/{messageId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

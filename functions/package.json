{
  "name": "evaraos-functions",
  "version": "1.0.0",
  "description": "Evaraos backend automation, AI command routing, and trusted server workflows.",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "index-stats.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions,firestore,auth,storage",
    "shell": "firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test intelligence/*.test.js studio-journal-core.test.js",
    "test:marketplace": "node --test marketplace-operations-core.test.js",
    "test:studio-journal": "node --test studio-journal-core.test.js",
    "test:all": "node --test intelligence/*.test.js marketplace-operations-core.test.js studio-journal-core.test.js"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "openai": "^4.104.0",
    "stripe": "^17.5.0"
  }
}
